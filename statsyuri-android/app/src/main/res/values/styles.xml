<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform-only theme: no Material Components dependency, compatible with Android 12. -->
    <style name="Theme.StatsYuri" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/statsyuri_background</item>
        <item name="android:navigationBarColor">@color/statsyuri_background</item>
        <item name="android:colorAccent">@color/statsyuri_blue</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
