<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/statsyuri_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="StatsYuri"
                    android:textColor="@color/statsyuri_text"
                    android:textSize="31sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Making statistics easier to understand"
                    android:textColor="@color/statsyuri_cyan"
                    android:textSize="15sp" />
            </LinearLayout>

            <Button
                android:id="@+id/settingsButton"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="⚙"
                android:textSize="20sp"
                android:contentDescription="Open StatsYuri settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/statsyuri_surface"
                android:paddingStart="10dp"
                android:paddingTop="7dp"
                android:paddingEnd="10dp"
                android:paddingBottom="7dp"
                android:text="OFFLINE"
                android:textColor="@color/statsyuri_accent"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Your data stays on this device. Choose a dataset and StatsYuri will select and explain a suitable analysis."
            android:textColor="@color/statsyuri_muted"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@color/statsyuri_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ask StatsYuri"
                android:textColor="@color/statsyuri_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="The question is optional. Leave it empty for automatic dataset analysis."
                android:textColor="@color/statsyuri_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <EditText
                android:id="@+id/questionInput"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="13dp"
                android:gravity="top|start"
                android:hint="What do you want to find out?"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="14dp"
                android:textColor="@color/statsyuri_text"
                android:textColorHint="@color/statsyuri_muted"
                android:textSize="15sp"
                android:background="@color/statsyuri_surface" />

            <Button
                android:id="@+id/selectFileButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Choose CSV / Excel dataset"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/fileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="No dataset selected"
                android:textColor="@color/statsyuri_muted"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/modeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/efficientMode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Efficient"
                    android:textColor="@color/statsyuri_text"
                    android:textSize="13sp" />
                <RadioButton
                    android:id="@+id/fullMode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Full analysis"
                    android:textColor="@color/statsyuri_text"
                    android:textSize="13sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/modeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Efficient mode selects one compatible analysis and explains it."
                android:textColor="@color/statsyuri_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/analyzeButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="13dp"
                android:text="Analyze dataset"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/statsyuri_cyan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:id="@+id/resultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="© 2026 Yugen Beyondverse. All rights reserved."
            android:textColor="@color/statsyuri_footer"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
